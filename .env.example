# ============================================================================
# GRC Security Suite - On-Prem / Docker environment configuration
# Copy to `.env` and adjust. Used by docker-compose.yml.
# ============================================================================

# ---- PostgreSQL -----------------------------------------------------------
DB_USER=grc
DB_PASSWORD=change-me-strong-password
DB_NAME=grc_suite
DB_PORT=5432

# ---- AI provider ----------------------------------------------------------
# ollama | openai | none
AI_PROVIDER=ollama

# Ollama (local, on-prem, no API key required)
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI / Azure OpenAI (only used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Authentication / Security (hardened on-prem login) -------------------
# JWT_SECRET signs session cookies. It is BOTH baked into each app bundle at
# build time (so the app's verifier matches) AND used by the server at runtime.
# Generate a strong value, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-in-production
# SYNC_KEY authenticates GRC Pulse <-> Pentest Pulse cross-system sync. It MUST
# be identical for both services. Generate: openssl rand -hex 24
SYNC_KEY=change-me-in-production
# bcrypt cost factor for password hashing (10-12 is typical).
BCRYPT_ROUNDS=12
# Emergency recovery ONLY: set to 'true' to re-enable the universal master
# password (CisoHub@2026). Leave 'false' in normal operation.
ALLOW_MASTER_PASSWORD=false

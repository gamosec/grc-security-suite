# ============================================================================
# GRC Security Suite - On-Prem / Docker environment configuration
# Copy to `.env` and adjust. Used by docker-compose.yml.
# ============================================================================

# ---- PostgreSQL -----------------------------------------------------------
DB_USER=grc
DB_PASSWORD=change-me-strong-password
DB_NAME=grc_suite
DB_PORT=5432

# ---- AI provider ----------------------------------------------------------
# ollama | openai | none
AI_PROVIDER=ollama

# Ollama (local, on-prem, no API key required)
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI / Azure OpenAI (only used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Pentest Pulse --------------------------------------------------------
JWT_SECRET=change-me-in-production

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grc-pulse",
  "compatibility_date": "2025-12-24",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
